---
import meta from '../../content/meta.json';
---

<footer>
  <div class="container">
    <a href={meta.social.github} target="_blank" rel="noreferrer">Built by {meta.name}</a>
    <ul>
      {meta.social.github && <li><a href={meta.social.github} target="_blank" rel="noreferrer">GitHub</a></li>}
      {meta.social.linkedin && <li><a href={meta.social.linkedin} target="_blank" rel="noreferrer">LinkedIn</a></li>}
    </ul>
  </div>
</footer>

<style>
  footer { padding-block: var(--space-xl); font-size: var(--text-sm); color: var(--color-muted); }
  .container { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-md); }
  ul { list-style: none; display: flex; gap: var(--space-lg); padding: 0; margin: 0; }
  a { color: var(--color-ink-2); text-underline-offset: 0.25em; }
  a:hover { color: var(--color-accent); }
  a:active { color: var(--color-ink); }
</style>
