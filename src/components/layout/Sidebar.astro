---
import { Image } from 'astro:assets';
import meta from '../../content/meta.json';
import githubDark from '../../assets/github_dark.png';
import githubLight from '../../assets/github_light.png';
import linkedinDark from '../../assets/linkedin_dark.png';
import linkedinLight from '../../assets/linkedin_light.png';
---

<!-- Fixed left: social icon links -->
<div class="sidebar sidebar--left">
  <ul>
    {meta.social.github && (
      <li>
        <a href={meta.social.github} aria-label="GitHub" target="_blank" rel="noreferrer">
          <Image src={githubDark} alt="GitHub" width={50} height={50} densities={[1, 2]} loading="eager" class="icon-dark" />
          <Image src={githubLight} alt="GitHub" width={50} height={50} densities={[1, 2]} loading="eager" class="icon-light" />
        </a>
      </li>
    )}
    {meta.social.linkedin && (
      <li>
        <a href={meta.social.linkedin} aria-label="LinkedIn" target="_blank" rel="noreferrer">
          <Image src={linkedinDark} alt="LinkedIn" width={50} height={50} densities={[1, 2]} loading="eager" class="icon-dark" />
          <Image src={linkedinLight} alt="LinkedIn" width={50} height={50} densities={[1, 2]} loading="eager" class="icon-light" />
        </a>
      </li>
    )}
    {meta.social.twitter && (
      <li>
        <a href={meta.social.twitter} aria-label="Twitter" target="_blank" rel="noreferrer">
          TW
        </a>
      </li>
    )}
  </ul>
</div>


<style>
  .sidebar {
    position: fixed;
    bottom: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .sidebar::after {
    content: '';
    display: block;
    width: 1px;
    height: 90px;
    background: var(--color-slate);
  }
  .sidebar--left  { left: 40px; }

  .sidebar--left ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sidebar--left a {
    color: var(--color-slate);
    font-family: var(--font-mono);
    font-size: 12px;
    text-decoration: none;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sidebar--left a:hover {
    color: var(--color-accent);
    transform: translateY(-3px);
  }
  .icon-dark,
  .icon-light {
    display: none;
  }
  :global([data-theme="dark"]) .icon-dark,
  :global(:root:not([data-theme])) .icon-dark {
    display: block;
  }
  :global([data-theme="light"]) .icon-light {
    display: block;
  }

  @media (max-width: 1080px) { .sidebar { display: none; } }
</style>
