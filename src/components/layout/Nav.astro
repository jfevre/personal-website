---
import meta from '../../content/meta.json';
const navLinks = ['About', 'Experience', 'Projects', 'Contact', 'Visitors'];
---

<header>
  <nav class="container">
    <a href="/" class="logo" aria-label="home">
      <img src="/logo.png" alt="JF" width="36" height="36" class="logo-dark" />
      <img src="/lightmode.png" alt="JF" width="36" height="36" class="logo-light" />
    </a>
    <div class="mobile-controls">
      <button id="theme-toggle-mobile" class="theme-toggle-mobile" aria-label="Toggle theme" title="Toggle theme">
        <span class="mode-dark">dark</span><span class="mode-light">light</span>
      </button>
      <button id="menu-toggle" class="menu-toggle" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <ul class="nav-links">
      {navLinks.map((link) => (
        <li>
          <a href={`#${link.toLowerCase()}`} class="nav-link">{link}</a>
        </li>
      ))}
      <li class="mobile-only">
        {meta.social.github && <a href={meta.social.github} target="_blank" rel="noreferrer" class="nav-link">GitHub</a>}
      </li>
      <li class="mobile-only">
        {meta.social.linkedin && <a href={meta.social.linkedin} target="_blank" rel="noreferrer" class="nav-link">LinkedIn</a>}
      </li>
      <li>
        <button id="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
          <span class="mode-dark">dark</span><span class="mode-light">light</span>
        </button>
      </li>
    </ul>
  </nav>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    width: 100%;
    height: var(--nav-height);
    z-index: var(--z-sticky-nav);
    background: var(--color-paper);
  }
  header.scrolled { background: var(--color-paper-2); }
  nav {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo { display: flex; line-height: 0; }
  .logo-light { display: none; }
  :global([data-theme="light"]) .logo-dark { display: none; }
  :global([data-theme="light"]) .logo-light { display: block; }

  .nav-links { list-style: none; display: flex; align-items: center; gap: var(--space-xs); }
  .nav-link, #theme-toggle, .theme-toggle-mobile {
    font: 500 var(--text-sm)/1 var(--font-body);
    color: var(--color-ink-2);
    text-decoration: none;
    background: none;
    border: var(--rule-hair) solid transparent;
    border-radius: var(--radius-pill);
    cursor: pointer;
    padding: var(--space-sm) var(--space-md);
    transition: color var(--dur-short) var(--ease-out), background-color var(--dur-short) var(--ease-out);
  }
  #theme-toggle, .theme-toggle-mobile { border-color: var(--color-ink-2); }
  .nav-link:hover, #theme-toggle:hover, .theme-toggle-mobile:hover { color: var(--color-sky-ink); background: var(--color-sky); }
  .nav-link:active, #theme-toggle:active, .theme-toggle-mobile:active { background: var(--color-paper-3); }
  .nav-link:focus-visible, #theme-toggle:focus-visible, .theme-toggle-mobile:focus-visible, .menu-toggle:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }

  .mode-light { display: none; }
  :global([data-theme="light"]) .mode-dark { display: none; }
  :global([data-theme="light"]) .mode-light { display: inline; }

  .mobile-controls, .mobile-only { display: none; }
  .menu-toggle { background: none; border-radius: var(--radius-pill); border: var(--rule-hair) solid var(--color-ink-2); width: 40px; height: 36px; display: flex; flex-direction: column; justify-content: center; gap: var(--space-2xs); padding: 0 var(--space-xs); cursor: pointer; }
  .menu-toggle span { display: block; height: 1px; background: var(--color-ink); }

  @media (max-width: 60rem) {
    .mobile-controls { display: flex; align-items: center; gap: var(--space-sm); }
    .mobile-only { display: list-item; }
    .nav-links {
      position: absolute;
      top: var(--nav-height);
      left: 0; right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
      padding: var(--space-lg) var(--gutter);
      background: var(--color-paper);
      border-bottom-left-radius: var(--radius-card); border-bottom-right-radius: var(--radius-card);
      display: none;
    }
    .nav-links.active { display: flex; }
    .nav-links > li:last-child { display: none; }
  }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const navLinks = document.querySelector('.nav-links');

  menuToggle?.addEventListener('click', () => {
    menuToggle.classList.toggle('active');
    navLinks?.classList.toggle('active');
  });

  // Close menu when clicking a nav link
  document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', () => {
      menuToggle?.classList.remove('active');
      navLinks?.classList.remove('active');
    });
  });

  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    if (!navLinks?.contains(e.target as Node) && !menuToggle?.contains(e.target as Node)) {
      menuToggle?.classList.remove('active');
      navLinks?.classList.remove('active');
    }
  });
</script>
