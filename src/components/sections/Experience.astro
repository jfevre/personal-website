---
import jobs from '../../content/jobs.json';
---

<section id="experience">
  <div class="container split">
    <div class="head"><h2>Experience</h2></div>
    <ol class="log">
      {jobs.map((job) => (
        <li class="job">
          <div class="job-meta">
            <p class="job-range">{job.range}</p>
          </div>
          <div class="job-main">
            <h3 class="job-title">
              {job.role} at
              {job.url
                ? <a href={job.url} target="_blank" rel="noreferrer" class="company-link">{job.company}</a>
                : <span class="company-link">{job.company}</span>
              }
            </h3>
            <ul class="job-bullets">
              {job.bullets.map(bullet => <li>{bullet}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .log { list-style: none; padding: 0; margin: 0; }
  .job { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 7fr); gap: var(--gap-columns); padding-block: var(--space-xl); border-top: var(--rule-hair) solid var(--color-rule); }
  .job:first-child { border-top: 0; padding-top: 0; }
  .job-range { display: inline-block; padding: var(--space-xs) var(--space-md); border-radius: var(--radius-pill); background: var(--color-paper-3); color: var(--color-ink); font-size: var(--text-sm); font-weight: 500; }
  .job-title { font-size: var(--text-2xl); font-weight: 600; max-width: none; margin-bottom: var(--space-md); }
  .company-link { color: inherit; text-decoration-style: dotted; text-underline-offset: 0.2em; }
  a.company-link:hover { text-decoration-style: solid; }
  .job-bullets { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-sm); }
  .job-bullets li { position: relative; padding-left: var(--space-lg); color: var(--color-ink-2); }
  .job-bullets li::before { content: ""; position: absolute; left: 0; top: 0.85em; width: 12px; border-top: 2px solid var(--color-accent); }
  @media (max-width: 60rem) { .job { grid-template-columns: minmax(0, 1fr); gap: var(--space-sm); } }
</style>
