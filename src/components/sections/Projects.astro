---
import projects from '../../content/projects.json';
const featured = projects.filter(p => p.featured);
const others = projects.filter(p => !p.featured);
---

<section id="projects">
  <div class="container split">
    <div class="head"><h2>Projects</h2></div>
    <article class="projects-body">
      <ul class="featured-list">
        {featured.map((project) => (
          <li class="featured-project">
            <div class="project-head">
              <h3 class="project-name">{project.name}</h3>
              {(project.github || project.external) && (
                <p class="project-links">
                  {project.github && <a href={project.github} target="_blank" rel="noreferrer">GitHub</a>}
                  {project.external && <a href={project.external} target="_blank" rel="noreferrer">Live Site</a>}
                </p>
              )}
            </div>
            <p class="project-description">{project.description}</p>
            <ul class="project-tech">
              {project.tech.map(t => <li>{t}</li>)}
            </ul>
            {project.image && <img src={project.image} alt={project.name} />}
          </li>
        ))}
      </ul>

      {others.length > 0 && (
        <>
          <h3 class="other-heading">Other noteworthy projects</h3>
          <ul class="other-grid">
            {others.map((project) => (
              <li class="other-project">
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                <ul class="project-tech">
                  {project.tech.map(t => <li>{t}</li>)}
                </ul>
                {project.github && (
                  <p class="project-links"><a href={project.github} target="_blank" rel="noreferrer">GitHub</a></p>
                )}
              </li>
            ))}
          </ul>
        </>
      )}
    </article>
  </div>
</section>

<style>
  ul { list-style: none; padding: 0; margin: 0; }
  .featured-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg); }
  .featured-project { display: flex; flex-direction: column; gap: var(--space-md); padding: var(--space-xl); border-radius: var(--radius-card); background: var(--color-paper-2); color: var(--color-ink); min-height: 360px; transition: transform var(--dur-short) var(--ease-out); }
  .featured-project:nth-child(4n+1) { background: var(--color-sky); color: var(--color-sky-ink); }
  .featured-project:nth-child(4n+2) { background: var(--color-accent); color: var(--color-accent-ink); }
  .featured-project:nth-child(4n+4) { background: var(--color-ink); color: var(--color-paper); }
  .featured-project:hover { transform: translateY(-4px); }
  .featured-project a { color: inherit; }
  .project-head { display: flex; flex-direction: column; gap: var(--space-sm); }
  .project-name { font-size: var(--text-2xl); font-weight: 600; max-width: none; }
  .project-links { display: flex; gap: var(--space-lg); font-size: var(--text-sm); font-weight: 500; }
  .project-description { max-width: 62ch; }
  .project-tech { display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-md); font-size: var(--text-sm); font-weight: 500; margin-top: auto; opacity: 0.85; }
  .other-heading { margin-top: var(--space-2xl); margin-bottom: var(--space-lg); font-family: var(--font-body); font-size: var(--text-sm); font-weight: 500; color: var(--color-muted); }
  .other-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg); }
  .other-project { display: flex; flex-direction: column; gap: var(--space-sm); padding: var(--space-lg); border: 2px solid var(--color-ink); border-radius: var(--radius-card); transition: transform var(--dur-short) var(--ease-out); }
  .other-project:hover { transform: translateY(-3px); }
  .other-project h3 { font-size: var(--text-xl); font-weight: 600; }
  .other-project p { color: var(--color-ink-2); font-size: var(--text-sm); }
  .other-project .project-tech { color: var(--color-muted); opacity: 1; }
  @media (max-width: 60rem) { .featured-list { grid-template-columns: minmax(0, 1fr); } .featured-project { min-height: 0; } }
  @media (max-width: 40rem) { .other-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .featured-project:hover, .other-project:hover { transform: none; } }
</style>
