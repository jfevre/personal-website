---
import { Image } from 'astro:assets';
import about from '../../content/about.json';
import headshot from '../../assets/headshot.png';
const { skills, certifications } = about;
---

<section id="about">
  <h2 class="section-heading fade-up" data-number="01.">About Me</h2>

  <div class="about-grid fade-up">
    <div class="about-text">
      <p>
        I'm a DevOps Engineer at Awaze in Manchester, where I work across a multi-account AWS estate:
        identity and access, CDN, CI/CD runners, security guardrails and cost. I started in 2013 on stadium WiFi
        and third-line support, moved into infrastructure consulting on government platforms, and have spent the
        last few years turning hand-built AWS infrastructure into Terraform and Terragrunt.
      </p>
      <p>
        My recent work has been heavy on identity, security and cost. I moved our AWS accounts onto IAM Identity
        Centre with just-in-time production access, led security remediation across 46 repositories, and
        redesigned our NAT gateways to cut NAT costs by over 80%. I also build on AWS's AI services, from a Bedrock
        pipeline that extracts metadata from millions of property images to a FinOps agent running on Bedrock
        AgentCore.
      </p>
      <p>
        I hold the AWS Solutions Architect and DevOps Engineer Professional certifications, previously held SC
        clearance, and studied Business & ICT at Sheffield Hallam University (2:1). The problems I enjoy most are
        where infrastructure and developer experience overlap.
      </p>

      <h3 class="subsection-heading">Certifications</h3>
      <ul class="skills-list certs">
        {certifications.map(cert => (
          <li>
            {cert.url ? (
              <a href={cert.url} target="_blank" rel="noopener noreferrer" class="cert-link">
                {cert.name}
              </a>
            ) : (
              cert.name
            )}
          </li>
        ))}
      </ul>

      <h3 class="subsection-heading">Technologies</h3>
      <ul class="skills-list">
        {skills.map(skill => <li>{skill}</li>)}
      </ul>
    </div>

    <div class="about-photo">
      <div class="photo-wrapper">
        <Image src={headshot} alt="John Fevre" width={600} widths={[300, 600]} sizes="300px" />
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 50px;
    align-items: start;
  }
  .about-text p {
    margin-bottom: 15px;
  }
  .skills-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(140px, 200px));
    gap: 0 10px;
    list-style: none;
    margin-top: 20px;
  }
  .skills-list li {
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 4px 0;
  }
  .skills-list li::before {
    content: '▹ ';
    color: var(--color-accent);
  }
  .skills-list.certs {
    grid-template-columns: 1fr;
  }
  .cert-link {
    color: var(--color-slate-light);
    text-decoration: none;
    transition: var(--transition);
  }
  .cert-link:hover {
    color: var(--color-accent);
  }
  .subsection-heading {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-white);
    margin-top: 25px;
    margin-bottom: 10px;
  }
  .photo-wrapper {
    position: relative;
    max-width: 300px;
    border-radius: var(--border-radius);
    box-shadow: 0 0 20px rgba(255, 107, 53, 0.25);
    transition: box-shadow 0.3s ease;
  }
  .photo-wrapper:hover {
    box-shadow: 0 0 35px rgba(255, 107, 53, 0.5);
  }
  :global([data-theme="light"]) .photo-wrapper {
    box-shadow: 0 0 20px rgba(31, 95, 31, 0.3);
  }
  :global([data-theme="light"]) .photo-wrapper:hover {
    box-shadow: 0 0 35px rgba(31, 95, 31, 0.55);
  }
  .photo-wrapper img {
    width: 100%;
    height: auto;
    border-radius: var(--border-radius);
    display: block;
  }

  @media (max-width: 768px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-photo { max-width: 250px; margin: 0 auto; }
  }
</style>
