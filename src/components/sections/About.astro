---
import about from '../../content/about.json';
const { skills, certifications } = about;
---

<section id="about">
  <div class="container split">
    <div class="head"><h2>About</h2></div>
    <article class="about-body">
      <div class="about-text">
        <p class="lead">
          I’m a DevOps/Cloud Engineer based in Manchester with over 10 years of experience in infrastructure and automation.
          I specialise in building automated, scalable cloud solutions, turning manual processes into reliable pipelines
          and helping teams ship with confidence.
        </p>
        <p>
          I’ve worked across government, travel, and transport sectors, delivering everything from serverless AI pipelines
          to large-scale Active Directory migrations. I previously held SC security clearance and enjoy solving problems that
          sit at the intersection of infrastructure, automation, and developer experience.
        </p>
        <p>
          I studied Business &amp; ICT at Sheffield Hallam University (2:1), and I’m always learning, currently building
          with AWS Bedrock, Step Functions, and modern IaC practices.
        </p>
      </div>

      <div class="lists">
        <div>
          <h3>Certifications</h3>
          <ul class="certs">
            {certifications.map(cert => (
              <li>
                {cert.url ? (
                  <a href={cert.url} target="_blank" rel="noopener noreferrer" class="cert-link">{cert.name}</a>
                ) : (
                  cert.name
                )}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Technologies</h3>
          <ul class="skills">
            {skills.map(skill => <li>{skill}</li>)}
          </ul>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .about-body { display: grid; gap: var(--space-2xl); }
  .about-text { display: grid; gap: var(--space-lg); }
  .lead { color: var(--color-ink); font-size: var(--text-xl); line-height: 1.4; max-width: 40ch; }
  .lists { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--gap-columns); }
  h3 { font-family: var(--font-body); font-size: var(--text-sm); font-weight: 500; color: var(--color-muted); margin-bottom: var(--space-md); }
  ul { list-style: none; padding: 0; margin: 0; }
  .certs li { padding-block: var(--space-sm); border-top: var(--rule-hair) solid var(--color-rule); }
  .certs li:last-child { border-bottom: var(--rule-hair) solid var(--color-rule); }
  .skills { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .skills li { padding: var(--space-xs) var(--space-md); border-radius: var(--radius-pill); background: var(--color-sky); color: var(--color-sky-ink); font-size: var(--text-sm); font-weight: 500; }
  @media (max-width: 60rem) { .lists { grid-template-columns: minmax(0, 1fr); } }
</style>
