---
import meta from '../../content/meta.json';
---

<section id="contact" class="band">
  <div class="container split">
    <div class="head"><h2>Get in touch</h2></div>
    <div class="contact-body">
      <p class="lead contact-text">
        I’m currently open to new opportunities. Whether you have a question, a project in mind,
        or just want to connect, feel free to reach out.
      </p>
      <a href={meta.social.linkedin} target="_blank" rel="noreferrer" class="btn">Connect on LinkedIn</a>
    </div>
  </div>
</section>

<style>
  .band { background: var(--color-sky); color: var(--color-sky-ink); margin-inline: var(--space-md); border-radius: var(--radius-card); padding-block: var(--section-gap); }
  .contact-body { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-xl); }
  .contact-text { color: var(--color-sky-ink); font-size: var(--text-xl); line-height: 1.4; max-width: 36ch; }
  h2 { font-size: var(--text-display); font-weight: 600; }
  .head h2 { max-width: 8ch; }
  @media (max-width: 40rem) { .band { margin-inline: 0; border-radius: 0; } }
</style>
